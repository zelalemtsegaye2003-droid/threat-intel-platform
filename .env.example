# Environment Variables for ThreatIntel Platform

# API Keys (Optional - services work without them)
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=

# Google Gemini AI (replaces Ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# For Vertex AI (Agent Platform), set these instead:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
USE_VERTEX_AI=false

# Database
POSTGRES_PASSWORD=threatintel_secure_password_change_me
DATABASE_URL=postgresql://threatintel:threatintel_secure_password_change_me@localhost:5432/threatintel

# Neo4j
NEO4J_PASSWORD=threatintel_neo4j_password_change_me
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# Qdrant
QDRANT_URL=http://localhost:6333

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://threatintel:threatintel_secure_password_change_me@localhost:5672/

# Application
API_PORT=8000
LOG_LEVEL=info
SECRET_KEY=change_this_secret_key_in_production
JWT_SECRET=change_this_jwt_secret_in_production_min_32_chars

# Phase 1 security: environment=production disables OpenAPI/ReDoc by default unless ENABLE_API_DOCS=true
ENVIRONMENT=development
# ENABLE_API_DOCS=true
RATE_LIMIT_BACKEND=redis
SECURITY_HSTS_MAX_AGE_SECONDS=
# Set true only when TLS is enforced upstream (ingress / reverse proxy)
TLS_TERMINATED_UPSTREAM=false
# SECURITY_CSP=  # Optional override for Content-Security-Policy on API responses

# Phase 2 data lifecycle
# DB_SCHEMA_MANAGEMENT=migrations (recommended) or autocreate (dev only)
DB_SCHEMA_MANAGEMENT=migrations

# Phase 3 operations
UVICORN_WORKERS=1
UVICORN_TIMEOUT_KEEP_ALIVE=65
RUN_DB_MIGRATIONS_ON_START=false
# READINESS_REQUIRE_REDIS=true  # force /ready to check Redis even if using memory rate-limit

# Phase 4 observability
ENABLE_METRICS=false
# METRICS_REQUIRE_AUTH=true  # defaults to true in production, false otherwise
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Phase 0 proxy/IP trust (enable only behind a trusted reverse proxy)
TRUST_X_FORWARDED_FOR=false
# TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.10

# Frontend — local dev URL (production Docker Compose build uses /api/v1 + nginx proxy)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Environment Variables for ThreatIntel Platform

# API Keys (Optional - services work without them)
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
OTX_API_KEY=

# Database
POSTGRES_PASSWORD=threatintel_secure_password_change_me
DATABASE_URL=postgresql://threatintel:threatintel_secure_password_change_me@localhost:5432/threatintel

# Neo4j
NEO4J_PASSWORD=threatintel_neo4j_password_change_me
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# Qdrant
QDRANT_URL=http://localhost:6333

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://threatintel:threatintel_secure_password_change_me@localhost:5672/

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# Application
API_PORT=8000
LOG_LEVEL=info
SECRET_KEY=change_this_secret_key_in_production

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
